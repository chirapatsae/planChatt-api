{
  "type": "bubble",
  "size": "mega",
  "body": {
    "type": "box",
    "layout": "vertical",
    "spacing": "none",
    "paddingAll": "16px",
    "contents": [
      {
        "type": "text",
        "text": "แผนชัด (PlanCHATT) · เทศบาลตำบลหนองกระทุ่ม",
        "size": "xxs",
        "color": "#6B7280",
        "weight": "regular",
        "wrap": false,
        "align": "center"
      },
      {
        "type": "text",
        "text": "โครงการผ่านการตรวจสอบ",
        "size": "lg",
        "weight": "bold",
        "color": "#111827",
        "wrap": true,
        "margin": "sm",
        "align": "center"
      },
      {
        "type": "image",
        "url": "{{iconBase}}/line-icons/project-verified-owner.png",
        "size": "72px",
        "aspectMode": "fit",
        "aspectRatio": "1:1",
        "align": "center",
        "margin": "md"
      },
      {
        "type": "separator",
        "color": "#E5E7EB",
        "margin": "md"
      },
      {
        "type": "box",
        "layout": "vertical",
        "spacing": "sm",
        "margin": "md",
        "contents": [
          {
            "type": "box",
            "layout": "baseline",
            "spacing": "sm",
            "contents": [
              {
                "type": "text",
                "text": "ชื่อโครงการ",
                "size": "xs",
                "color": "#6B7280",
                "flex": 3
              },
              {
                "type": "text",
                "text": "{{projectName}}",
                "size": "sm",
                "color": "#111827",
                "wrap": true,
                "flex": 7
              }
            ]
          },
          {
            "type": "box",
            "layout": "baseline",
            "spacing": "sm",
            "contents": [
              {
                "type": "text",
                "text": "สถานะ",
                "size": "xs",
                "color": "#6B7280",
                "flex": 3
              },
              {
                "type": "text",
                "text": "{{fromStatusTh}} → {{toStatusTh}}",
                "size": "sm",
                "color": "#111827",
                "wrap": true,
                "flex": 7
              }
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "type": "box",
    "layout": "vertical",
    "spacing": "sm",
    "paddingAll": "12px",
    "paddingTop": "0px",
    "contents": [
      {
        "type": "button",
        "style": "link",
        "color": "#4F46E5",
        "height": "sm",
        "gravity": "center",
        "action": {
          "type": "uri",
          "label": "เปิดดูโครงการ ›",
          "uri": "{{actionLink}}"
        }
      }
    ]
  }
}
