<p style="font-size: 14px; line-height: 1.6;">
  เรียน เจ้าของโครงการ
</p>
<p style="font-size: 14px; line-height: 1.6;">
  โครงการของท่านถูกส่งกลับเพื่อแก้ไข โปรดตรวจสอบเหตุผลด้านล่างและดำเนินการปรับแก้ก่อนนำส่งอีกครั้ง
</p>
<table style="width: 100%; font-size: 14px; border-collapse: collapse; margin: 16px 0;">
  <tr>
    <td style="padding: 6px 0; color: #6b7280; width: 160px;">ชื่อโครงการ</td>
    <td style="padding: 6px 0; color: #111827; font-weight: 600;">{{projectName}}</td>
  </tr>
  <tr>
    <td style="padding: 6px 0; color: #6b7280;">การเปลี่ยนสถานะ</td>
    <td style="padding: 6px 0; color: #111827;">{{fromStatus}} &rarr; {{toStatus}}</td>
  </tr>
</table>
{{#if reason}}
<div style="background: #fef3c7; border-left: 4px solid #f59e0b; padding: 12px 16px; border-radius: 4px; margin: 16px 0;">
  <p style="font-size: 12px; color: #92400e; margin: 0 0 4px 0; font-weight: 600;">เหตุผลจากผู้ตรวจสอบ</p>
  <p style="font-size: 14px; color: #111827; margin: 0; line-height: 1.6; white-space: pre-wrap;">{{reason}}</p>
</div>
{{/if}}
<p style="margin: 24px 0;">
  <a href="{{actionLink}}"
     style="display: inline-block; background-color: #dc2626; color: #ffffff; text-decoration: none; padding: 10px 20px; border-radius: 6px; font-size: 14px;">
    เปิดโครงการเพื่อแก้ไข
  </a>
</p>
