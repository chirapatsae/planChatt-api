{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "src/fonts/**/*",
        "outDir": "fonts"
      },
      {
        "include": "src/ai/data/**/*.json",
        "outDir": "ai/data",
        "watchAssets": true
      },
      {
        "include": "src/notifications/templates/**/*.hbs",
        "outDir": "src/notifications/templates",
        "watchAssets": true
      }
    ]
  }
}
